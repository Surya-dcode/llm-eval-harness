# Copy to .env and fill in only the keys for providers you use.
# evalh reads keys from the environment, so load this file first,
# for example:  set -a; source .env; set +a
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
ANTHROPIC_API_KEY=

# Optional: where cached responses are stored (default: ./.evalh_cache)
# EVALH_CACHE_DIR=.evalh_cache
